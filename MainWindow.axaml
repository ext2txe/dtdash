<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dtdash.MainWindow"
        Icon="/redicon.png"
        Width="900" Height="600" MinWidth="400" MinHeight="300"
        KeyDown="MainWindow_OnKeyDown">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Margin="24,24,24,12" Padding="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="Notes" FontSize="22" VerticalAlignment="Center" />
        <!-- Reserved for future search and option buttons. -->
      </Grid>
    </Border>

    <ListBox Name="NotesList" Grid.Row="1" Margin="24,0,24,12">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy note" Click="CopyNoteMenuItem_OnClick" />
          <Separator />
          <MenuItem Name="VersionMenuItem" IsEnabled="False" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>

    <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1,1,0,0" Padding="8,4">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
        <TextBlock Name="StatusText" Grid.Column="0" VerticalAlignment="Center" />
        <Button Name="NoteButton" Grid.Column="1" Content="Note" Padding="8,2" Margin="8,0,4,0" ToolTip.Tip="Add note" Click="NoteButton_OnClick" />
        <Button Name="LogButton" Grid.Column="2" Content="Log" Padding="8,2" Margin="8,0,4,0" ToolTip.Tip="View log file" Click="LogButton_OnClick" />
        <Button Name="SettingsButton" Grid.Column="3" Content="⚙" FontSize="18" Padding="8,2" Margin="8,0,4,0" ToolTip.Tip="Open settings" Click="SettingsButton_OnClick" />
        <TextBlock Name="ClockText" Grid.Column="4" VerticalAlignment="Center" MinWidth="65" TextAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>
