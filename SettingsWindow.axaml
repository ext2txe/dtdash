<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dtdash.SettingsWindow"
        Icon="/redicon.png"
        Title="Settings"
        Width="900" Height="450"
        MinWidth="350" MinHeight="250">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <Grid Grid.Row="0" ColumnDefinitions="160,*,160,80,2*" ColumnSpacing="8" Margin="0,0,0,6">
      <TextBlock Text="Named setting" FontWeight="Bold" />
      <TextBlock Grid.Column="1" Text="Value" FontWeight="Bold" />
      <TextBlock Grid.Column="2" Text="Section tag name" FontWeight="Bold" />
      <TextBlock Grid.Column="3" Text="Index" FontWeight="Bold" />
      <TextBlock Grid.Column="4" Text="Description" FontWeight="Bold" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{ReflectionBinding Settings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="160,*,160,80,2*" ColumnSpacing="8" Margin="0,3">
              <TextBlock Text="{ReflectionBinding Name}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{ReflectionBinding Value, Mode=TwoWay}" />
              <TextBlock Grid.Column="2" Text="{ReflectionBinding Section}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{ReflectionBinding SectionIndex}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{ReflectionBinding Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="2" Content="Save" HorizontalAlignment="Right" Width="90" Margin="0,8,0,0" Click="SaveButton_OnClick" />
  </Grid>
</Window>
